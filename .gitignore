# Include your project-specific ignores in this file
# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files

# Compiled output
**/dist/
**/*.tsbuildinfo

# Bun package manager
# https://bun.sh/docs/install/lockfile
node_modules/

# Logs
*.log

# Cache
/.cache
/*/.swc/
.eslintcache

# Testing
/coverage
*.lcov

# Environment variables
# Copy `.env.example` to `.env` and fill in real values.
.env
.env.*.local
.env.local

# Visual Studio Code
# https://github.com/github/gitignore/blob/master/Global/VisualStudioCode.gitignore
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/mcp.json
!.vscode/settings.json
!.vscode/tasks.json

# WebStorm
.idea

# Wrangler CLI
# https://developers.cloudflare.com/workers/wrangler/
.wrangler/

# Astro
.astro/

# TanStack Router
# Generated route tree files should not be committed
*/lib/routeTree.gen.ts
*/.tanstack/

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist

# React Email
.react-email/

# Srcpack
.srcpack/
srcpack.config.ts

# Local development files
*.local.md
*.local.json
*.local.jsonc
*.local.ts

# Browser automation screenshots
screenshots/

# macOS
# https://github.com/github/gitignore/blob/master/Global/macOS.gitignore
.DS_Store
/.glm.json
/.playwright-cli/
/logs/

# Python
__pycache__/
*.pyc
/db/logs/

# Ruflo
# Runtime/binary — regenerated automatically
.swarm/
.claude/memory.db
data/ruflo-memory/
claude-flow.config.json
# .claude-flow: commit config + capabilities, ignore runtime state
.claude-flow/daemon.pid
.claude-flow/daemon.log
.claude-flow/daemon-state.json
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/metrics/
.claude-flow/learning/
.claude-flow/security/
# .claude: ignore ruflo-bundled subdirs, keep project-specific .md files
.claude/agents/*/
.claude/commands/analysis/
.claude/commands/automation/
.claude/commands/bowser/
.claude/commands/cto-team/
.claude/commands/github/
.claude/commands/hooks/
.claude/commands/monitoring/
.claude/commands/optimization/
.claude/commands/sparc/
.claude/commands/claude-flow-help.md
.claude/commands/claude-flow-memory.md
.claude/commands/claude-flow-swarm.md
.claude/skills/
.claude/helpers/
.claude/statusline.mjs
.claude/statusline.sh
