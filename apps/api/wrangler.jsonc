{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // [METADATA]
  // API worker accessed via service binding from web worker (no routes needed).
  "name": "serene-api",
  "main": "./worker.ts",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "upload_source_maps": true,

  // [ENV:PRODUCTION]
  // Command: bun wrangler deploy
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Serene",
    "APP_ORIGIN": "https://serene.linktalentsbot.work",
    "ALLOWED_ORIGINS": "https://serene.linktalentsbot.work",
    "RESEND_EMAIL_FROM": "noreply@linktalentsbot.work"
  },
  // prettier-ignore
  "hyperdrive": [
    { "binding": "HYPERDRIVE_CACHED", "id": "8ddebffa8c83495f89e184507dea53df" },
    { "binding": "HYPERDRIVE_DIRECT", "id": "8ddebffa8c83495f89e184507dea53df" }
  ],
  // prettier-ignore
  "kv_namespaces": [
    { "binding": "AI_RATE_LIMIT", "id": "0b3dd3af83f34ec0bb2319b817604968" }
  ],

  "env": {
    // [ENV:DEVELOPMENT]
    // Command: bun wrangler dev
    "dev": {
      "vars": {
        "ENVIRONMENT": "development",
        "APP_NAME": "Serene",
        "APP_ORIGIN": "http://localhost:5173",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "RESEND_EMAIL_FROM": "onboarding@resend.dev"
      },
      // prettier-ignore
      "hyperdrive": [
        { "binding": "HYPERDRIVE_CACHED", "id": "your-dev-hyperdrive-cached-id-here" },
        { "binding": "HYPERDRIVE_DIRECT", "id": "your-dev-hyperdrive-direct-id-here" }
      ],
      // prettier-ignore
      "kv_namespaces": [
        { "binding": "AI_RATE_LIMIT", "id": "your-dev-ai-rate-limit-kv-id-here" }
      ]
    },

    // [ENV:STAGING]
    // Command: bun wrangler deploy --env staging
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_NAME": "Serene",
        "APP_ORIGIN": "https://staging.serene.example.com",
        "ALLOWED_ORIGINS": "https://staging.serene.example.com",
        "RESEND_EMAIL_FROM": "onboarding@resend.dev"
      },
      // prettier-ignore
      "hyperdrive": [
        { "binding": "HYPERDRIVE_CACHED", "id": "your-staging-hyperdrive-cached-id-here" },
        { "binding": "HYPERDRIVE_DIRECT", "id": "your-staging-hyperdrive-direct-id-here" }
      ],
      // prettier-ignore
      "kv_namespaces": [
        { "binding": "AI_RATE_LIMIT", "id": "your-staging-ai-rate-limit-kv-id-here" }
      ]
    },

    // [ENV:PREVIEW]
    // Command: bun wrangler deploy --env preview
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "APP_NAME": "Serene",
        "APP_ORIGIN": "https://preview.serene.example.com",
        "ALLOWED_ORIGINS": "https://preview.serene.example.com",
        "RESEND_EMAIL_FROM": "onboarding@resend.dev"
      },
      // prettier-ignore
      "hyperdrive": [
        { "binding": "HYPERDRIVE_CACHED", "id": "your-preview-hyperdrive-cached-id-here" },
        { "binding": "HYPERDRIVE_DIRECT", "id": "your-preview-hyperdrive-direct-id-here" }
      ],
      // prettier-ignore
      "kv_namespaces": [
        { "binding": "AI_RATE_LIMIT", "id": "your-preview-ai-rate-limit-kv-id-here" }
      ]
    }
  }
}
